<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Kart Blitz — Mario Kart Style Racing</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "game", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div id="game-shell">
      <canvas id="game-canvas"></canvas>

      <div id="hud" class="hidden">
        <div class="hud-top">
          <div class="hud-panel">
            <span class="label">LAP</span>
            <span id="hud-lap">1 / 3</span>
          </div>
          <div class="hud-panel position-panel">
            <span id="hud-position">1st</span>
            <span class="label">PLACE</span>
          </div>
          <div class="hud-panel">
            <span class="label">TIME</span>
            <span id="hud-time">0:00.0</span>
          </div>
        </div>

        <div class="hud-bottom">
          <div id="item-slot" class="item-slot empty">
            <span class="item-label">ITEM</span>
            <div id="item-icon"></div>
          </div>
          <div class="speedometer">
            <span id="hud-speed">0</span>
            <span class="label">KM/H</span>
          </div>
          <div id="minimap-wrap">
            <canvas id="minimap" width="140" height="100"></canvas>
          </div>
        </div>
      </div>

      <div id="start-screen" class="overlay">
        <div class="overlay-card">
          <h1>Kart Blitz</h1>
          <p class="tagline">Mario Kart-style racing in your browser</p>
          <div class="controls-info">
            <div><kbd>↑</kbd><kbd>↓</kbd> Accelerate / Brake</div>
            <div><kbd>←</kbd><kbd>→</kbd> Steer</div>
            <div><kbd>Space</kbd> Use weapon</div>
            <div><kbd>Shift</kbd> Drift boost</div>
          </div>
          <button id="start-btn" class="btn-primary">Start Race</button>
        </div>
      </div>

      <div id="countdown" class="overlay hidden">
        <span id="countdown-text">3</span>
      </div>

      <div id="finish-screen" class="overlay hidden">
        <div class="overlay-card">
          <h2 id="finish-title">Race Complete!</h2>
          <p id="finish-position"></p>
          <p id="finish-time"></p>
          <button id="restart-btn" class="btn-primary">Race Again</button>
        </div>
      </div>
    </div>

    <%= javascript_include_tag "kart_racer", defer: true %>
  </body>
</html>
