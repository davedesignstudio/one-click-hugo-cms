<div class="kart-home w-full max-w-4xl mx-auto text-center">
  <div class="mb-8">
    <h1 class="text-5xl font-black text-white mb-2 tracking-tight">
      🏎️ Kart Racer
    </h1>
    <p class="text-xl text-gray-300">
      Mario Kart-style racing with weapons, power-ups, and AI rivals!
    </p>
  </div>

  <div class="bg-gray-800/80 rounded-2xl p-8 mb-8 border border-gray-700 shadow-2xl">
    <h2 class="text-2xl font-bold text-yellow-400 mb-6">How to Play</h2>
    <div class="grid md:grid-cols-2 gap-6 text-left text-gray-300">
      <div>
        <h3 class="font-bold text-white mb-2">🏁 Racing</h3>
        <ul class="space-y-1 text-sm">
          <li><kbd class="bg-gray-700 px-2 py-0.5 rounded">WASD</kbd> or <kbd class="bg-gray-700 px-2 py-0.5 rounded">Arrow Keys</kbd> to drive</li>
          <li>Complete <strong class="text-white">3 laps</strong> to finish the race</li>
          <li>Stay on the track — grass slows you down!</li>
        </ul>
      </div>
      <div>
        <h3 class="font-bold text-white mb-2">💥 Weapons</h3>
        <ul class="space-y-1 text-sm">
          <li>Hit <strong class="text-yellow-400">?</strong> boxes for random items</li>
          <li><kbd class="bg-gray-700 px-2 py-0.5 rounded">Space</kbd> to use your weapon</li>
          <li>🟢 Shell · 🔴 Homing Shell · 🍌 Banana · 🍄 Boost · ⭐ Star · ⚡ Lightning</li>
        </ul>
      </div>
    </div>
  </div>

  <%= link_to "Start Racing!", play_path,
      class: "inline-block bg-red-600 hover:bg-red-500 text-white font-bold text-xl px-12 py-4 rounded-full shadow-lg transition transform hover:scale-105" %>

  <% if @scores.any? %>
    <div class="mt-12 bg-gray-800/60 rounded-xl p-6 border border-gray-700">
      <h2 class="text-xl font-bold text-yellow-400 mb-4">🏆 Leaderboard</h2>
      <table class="w-full text-sm text-gray-300">
        <thead>
          <tr class="text-gray-400 border-b border-gray-700">
            <th class="py-2 text-left">Player</th>
            <th class="py-2 text-center">Place</th>
            <th class="py-2 text-right">Time</th>
          </tr>
        </thead>
        <tbody>
          <% @scores.each do |score| %>
            <tr class="border-b border-gray-700/50">
              <td class="py-2 text-left text-white"><%= score.player_name %></td>
              <td class="py-2 text-center"><%= { 1 => "1st", 2 => "2nd", 3 => "3rd", 4 => "4th" }[score.position] || "#{score.position}th" %></td>
              <td class="py-2 text-right"><%= "%.2f" % score.total_time %>s</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
