<div class="game-container">
  <header class="game-header">
    <h1>Kart Racer</h1>
    <p class="tagline">Mario Kart-style racing in your browser</p>
  </header>

  <div class="canvas-wrapper">
    <canvas id="racing-canvas"></canvas>
  </div>

  <footer class="game-footer">
  <div class="controls-guide">
    <div class="control-group">
      <kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd>
      <span>or WASD to drive</span>
    </div>
    <div class="control-group">
      <kbd>SPACE</kbd>
      <span>use weapon</span>
    </div>
    <div class="control-group">
      <kbd>ENTER</kbd>
      <span>start / restart</span>
    </div>
  </div>
  <div class="weapons-guide">
    <span class="weapon banana">Banana</span>
    <span class="weapon shell">Green Shell</span>
    <span class="weapon red-shell">Red Shell</span>
    <span class="weapon mushroom">Mushroom</span>
    <span class="weapon star">Star</span>
    <span class="weapon lightning">Lightning</span>
  </div>
  </footer>
</div>
